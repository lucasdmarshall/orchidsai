DATABASE_URL=postgres://orchid:password@localhost/orchid
# Comma-separated; requests rotate between them.
OPENROUTER_API_KEYS=
# Address the API listens on (nginx proxies orchidapi.magickamimosa.com here).
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=https://orchidchat.magickamimosa.com
